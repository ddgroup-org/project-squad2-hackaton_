<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Enviar_Email_Alerta</name>
        <label>Enviar E-mail de Alerta</label>
        <locationX>50</locationX>
        <locationY>302</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>gabriel.jacob.cromatta@ddgroup.com.br</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Alerta de Concentração de Receita — Cromatta</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Preparar_Alerta.corpoEmail</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Preparar_Alerta</name>
        <label>Preparar Alerta de Concentração</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>ConcentracaoReceitaService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Decision_Ha_Alertas</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>ConcentracaoReceitaService</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_Ha_Alertas</name>
        <label>Há alertas para enviar?</label>
        <locationX>176</locationX>
        <locationY>218</locationY>
        <defaultConnectorLabel>Não — sem concentração acima do limite</defaultConnectorLabel>
        <rules>
            <name>Ha_Alertas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Preparar_Alerta.temAlerta</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enviar_Email_Alerta</targetReference>
            </connector>
            <label>Há alertas</label>
        </rules>
    </decisions>
    <description>Roda diariamente, chama ConcentracaoReceitaService.prepararAlertaConcentracao (agregação SUM/GROUP BY não é possível declarativamente em Flow — ver comentário na classe Apex) e envia e-mail a Gabriel Jacob quando um vendedor ou conta ultrapassa 40% do volume total de Opportunities Closed Won. Ver demanda-11 e business-scenario.md/BRD 4.1.</description>
    <environments>Default</environments>
    <interviewLabel>Alerta Concentração de Receita {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Alerta de Concentração de Receita</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Preparar_Alerta</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-14</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
